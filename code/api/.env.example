OPENAI_API_KEY=your-openai-api-key
REDIS_URL=redis://redis:6379
PORT=8000
OPENAI_MODEL=gpt-4.1-mini
MODEL_FAST=gpt-4.1-mini
MODEL_BALANCED=gpt-4.1-mini
MODEL_DEEP=gpt-4.1
CACHE_EMBEDDING_MODEL=redis/langcache-embed-v3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CACHE_INDEX_NAME=idx:research_semantic_cache
CACHE_PREFIX=semcache:research:
CACHE_TTL_SECONDS=86400
CACHE_DISTANCE_THRESHOLD=0.12
ROUTER_INDEX_NAME=idx:support_semantic_router
ROUTER_PREFIX=semrouter:support:
ROUTER_DISTANCE_THRESHOLD=0.3
FAQ_INDEX_NAME=idx:faq_semantic_router
FAQ_PREFIX=faqrouter:support:
FAQ_DISTANCE_THRESHOLD=0.45
FAQ_SEARCH_LIMIT=3
